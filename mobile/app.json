{
  "expo": {
    "name": "A Date At las",
    "slug": "date-atlas-mobile",
    "version": "0.1.1",
    "scheme": "adateatlas",
    "icon": "./assets/icon.png",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "light",
    "plugins": [
      ["expo-location", { "locationAlwaysPermission": false, "locationAlwaysAndWhenInUsePermission": false }]
    ],
    "ios": {
      "bundleIdentifier": "com.adateatlas.mobile",
      "buildNumber": "3",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Use your location to find date ideas around you.",
        "NSMicrophoneUsageDescription": "Use the microphone when you choose to tell Oge about your date.",
        "NSSpeechRecognitionUsageDescription": "Turn your spoken date ideas into text you can review before sending."
      }
    },
    "android": {
      "package": "com.adateatlas.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D91335"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    }
  }
}
