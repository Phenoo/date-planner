# Live is the default. Only choose demo explicitly for fictional development data.
DATE_ATLAS_CATALOG_MODE=live
# Firebase web configuration (public; restrict domains in Firebase Auth).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-only Firebase credentials. Alternatively use GOOGLE_APPLICATION_CREDENTIALS / ADC.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# DeepSeek: server only. Never prefix this key with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Public key, restricted to Maps Embed API and your website's HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Random server-only secret for hashing planner rate-limit keys.
PLANNER_RATE_LIMIT_SECRET=
# Private HTTPS Cloud Function URL. With this set, Next routes proxy to Firebase.
DATE_ATLAS_FUNCTIONS_URL=
# Optional reCAPTCHA v3 App Check site key; enable enforcement after registering the app.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# Server-only key restricted to the Geocoding API and Places API (New).
GOOGLE_MAPS_SERVER_KEY=
# Paystack server key. Checkout stays unavailable until configured.
PAYSTACK_SECRET_KEY=
APP_ORIGIN=http://127.0.0.1:3000
